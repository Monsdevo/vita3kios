 // Get the primary network interface name using SystemConfiguration
 bool get_primary_interface_name(char *dest, size_t bufferSize) {
+#if TARGET_OS_IPHONE
+    if (!dest || bufferSize == 0)
+        return false;
+
+    struct ifaddrs *iflist = nullptr;
+    if (getifaddrs(&iflist) != 0)
+        return false;
+
+    bool success = false;
+    for (struct ifaddrs *cur = iflist; cur; cur = cur->ifa_next) {
+        if (!cur->ifa_addr || !cur->ifa_name)
+            continue;
+        if (!(cur->ifa_flags & IFF_UP) || (cur->ifa_flags & IFF_LOOPBACK))
+            continue;
+        if (!is_physical_interface(cur->ifa_name))
+            continue;
+        if (cur->ifa_addr->sa_family != AF_INET && cur->ifa_addr->sa_family != AF_INET6)
+            continue;
+        strlcpy(dest, cur->ifa_name, bufferSize);
+        success = true;
+        break;
+    }
+    freeifaddrs(iflist);
+    return success;
+#else
     bool success = false;
     auto size = static_cast<CFIndex>(bufferSize);
 
